# Vorlage für die Umgebungsvariablen.
# Kopieren nach .env.local und dort ausfüllen. .env.local wird NIE committet.
# Werte findest du im Supabase-Dashboard unter Project Settings → API Keys.

# --- Supabase (in .env.local: Projekt brinkmann-dev) ---
# Öffentlich: darf im Browser landen, RLS schützt die Daten.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GEHEIM: nur auf dem Server. Niemals mit NEXT_PUBLIC_ beginnen lassen!
SUPABASE_SECRET_KEY=

# --- Login ---
# Interne Login-Domain, z. B. login.<eure-firmendomain>. Aus dem Benutzernamen
# "sebastian" wird intern "sebastian@<LOGIN_EMAIL_DOMAIN>".
LOGIN_EMAIL_DOMAIN=

# --- Umgebung ---
# "development" erlaubt das Seed-Skript (Testdaten). In Live NIE setzen.
APP_ENV=development

# Passwort aller Demo-Zugänge (demo-admin, demo-buero, demo-sebastian …).
# Leer lassen: npm run seed erzeugt eins und trägt es in .env.local ein.
SEED_PASSWORT=

# --- E-Mail-Versand der Angebote (SMTP-Zugang des Postfachs, z. B. info@maler-brinkmann.de) ---
# Zugangsdaten gibt der Mail-Anbieter. Nur lokal in .env.local und online in Vercel eintragen, nie in den Code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absender, der beim Empfänger steht (leer = SMTP_USER)
SMTP_FROM=

# --- Lexware Office (Rechnungen, Phase 5) ---
# API-Schlüssel unter https://app.lexware.de/addons/public-api erzeugen. GEHEIM, nur serverseitig.
LEXWARE_API_KEY=
# Optional: LEXWARE_MODUS=entwurf legt Rechnungen in Lexware nur als ENTWURF an (zum Testen). Leer = sofort finalisieren.
LEXWARE_MODUS=

# sevdesk (Buchhaltung im Hintergrund, ersetzt Lexware für NEUE Rechnungen). Den API-Token gibt es in sevdesk unter Einstellungen -> Benutzer.
SEVDESK_API_TOKEN=
# Optional: SEVDESK_MODUS=entwurf legt Rechnungen in sevdesk nur als ENTWURF an (zum Testen). Leer = sofort fertigstellen.
SEVDESK_MODUS=
# Optional: BUCHHALTUNG_ANBIETER=lexware erzwingt Lexware, obwohl ein sevdesk-Token da ist (sonst gilt sevdesk).
BUCHHALTUNG_ANBIETER=

# --- Eingangsrechnungen per E-Mail abholen (IMAP-Zugang eines Postfachs nur für Rechnungen) ---
# Gelesen werden nur UNGELESENE Mails; Anhänge (PDF, XML, Bilder) werden zu Eingangsrechnungen, die Mail gilt danach als gelesen.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Ordner im Postfach (leer = INBOX)
IMAP_ORDNER=
# Geheimnis für den täglichen automatischen Abruf (Vercel Cron schickt es mit). Zufälliger langer Text.
CRON_SECRET=

# KI-Auslesen von Eingangsrechnungen (Fotos, Scans, schwierige PDFs). AUS, solange KI_RECHNUNG_AKTIV nicht 1 ist. Kostet pro Rechnung Geld.
# Vorher: Vertrag zur Auftragsverarbeitung mit dem Anbieter (Anthropic) klären. Der Schlüssel kommt nur hierher, nie in den Chat oder Code.
KI_RECHNUNG_AKTIV=
ANTHROPIC_API_KEY=
# Optional: anderes Modell (Standard claude-opus-5-5, günstiger z. B. claude-haiku-5-5)
KI_MODELL=

# Telefon-KI (Anrufe): Geheimnis für den Webhook /api/anrufe, den der Telefon-Dienst nach jedem Anruf aufruft. Zufälliger langer Text. Ohne Wert tut die Adresse nichts.
ANRUFE_WEBHOOK_SECRET=
