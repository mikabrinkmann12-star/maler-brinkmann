# Vorlage für die Umgebungsvariablen.
# Kopieren nach .env.local und dort ausfüllen. .env.local wird NIE committet.
# Werte findest du im Supabase-Dashboard unter Project Settings → API Keys.

# --- Supabase (in .env.local: Projekt brinkmann-dev) ---
# Öffentlich: darf im Browser landen, RLS schützt die Daten.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GEHEIM: nur auf dem Server. Niemals mit NEXT_PUBLIC_ beginnen lassen!
SUPABASE_SECRET_KEY=

# --- Login ---
# Interne Login-Domain, z. B. login.<eure-firmendomain>. Aus dem Benutzernamen
# "sebastian" wird intern "sebastian@<LOGIN_EMAIL_DOMAIN>".
LOGIN_EMAIL_DOMAIN=

# --- Umgebung ---
# "development" erlaubt das Seed-Skript (Testdaten). In Live NIE setzen.
APP_ENV=development

# Passwort aller Demo-Zugänge (demo-admin, demo-buero, demo-sebastian …).
# Leer lassen: npm run seed erzeugt eins und trägt es in .env.local ein.
SEED_PASSWORT=

# --- E-Mail-Versand der Angebote (SMTP-Zugang des Postfachs, z. B. info@maler-brinkmann.de) ---
# Zugangsdaten gibt der Mail-Anbieter. Nur lokal in .env.local und online in Vercel eintragen, nie in den Code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absender, der beim Empfänger steht (leer = SMTP_USER)
SMTP_FROM=

# --- Lexware Office (Rechnungen, Phase 5) ---
# API-Schlüssel unter https://app.lexware.de/addons/public-api erzeugen. GEHEIM, nur serverseitig.
LEXWARE_API_KEY=
# Optional: LEXWARE_MODUS=entwurf legt Rechnungen in Lexware nur als ENTWURF an (zum Testen). Leer = sofort finalisieren.
LEXWARE_MODUS=
