# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files – Secrets niemals committen, nur die leere Vorlage
.env*
!.env.example

# supabase CLI (lokale Verknüpfungsdaten)
/supabase/.temp
/supabase/.branches

# claude code (lokale Einstellungen)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Einmalige Zugangsdaten-Dateien (Startpasswörter), nie committen
zugangsdaten-*.txt
